# Firebase web application configuration
VITE_apiKey=your_firebase_api_key
VITE_authDomain=your-project.firebaseapp.com
VITE_projectId=your-project-id
VITE_storageBucket=your-project.appspot.com
VITE_messagingSenderId=your_messaging_sender_id
VITE_appId=your_firebase_app_id

# ImgBB API key used for profile-image uploads
VITE_IMAGE_HOSTING_KEY=your_imgbb_api_key

# Stripe publishable key (never use a secret key in Vite client code)
VITE_PAYMENT_GATEWAY_PK=pk_test_your_stripe_publishable_key

# API base URL (falls back to the deployed Urban Dwell API when omitted)
VITE_API_URL=https://your-api.example.com
